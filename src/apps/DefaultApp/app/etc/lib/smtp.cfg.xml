<!-- Configuration -->
<config>
	<!-- Development Environment -->
	<dev>
	</dev>
	<!-- Test Environment -->
	<test>
	</test>
	<!-- Production Environment -->
	<prod>
		<!-- SMTP Settings -->
		<smtp>
			<!-- Enable SSL? -->
			<ssl>1</ssl>
			<!-- SMTP Server hostname ( defaults to localhost ) -->
			<server>mail.webserv.co</server>
			<!-- SMTP Server Port ( defaults to 25) -->
			<port>587</port>
			<!-- SMTP connection timeout (defaults to 45) -->
			<timeout>45</timeout>
			<!-- SMTP user name (blank for no authentication) -->
			<user></user>
			<!-- SMTP password (blank for no authentication) -->
			<password></password>
			<!-- Application hostname -->
			<host>webserv.co</host>
		</smtp>
	</prod>
</config>