<?xml version="1.0" encoding="UTF-8" ?>
<!-- $Id$ -->

<!-- Configuration -->
<config>
	<!-- Development Environment -->
	<dev>
		<!-- SMTP Settings -->
		<smtp>
			<!-- Enable SSL? -->
			<ssl>1</ssl>
			<!-- SMTP Server hostname ( defaults to localhost ) -->
			<server>smtp.gmail.com</server>
			<!-- SMTP Server Port ( defaults to 25) -->
			<port>465</port>
			<!-- SMTP connection timeout (defaults to 45) -->
			<timeout>45</timeout>
			<!-- SMTP user name (blank for no authentication) -->
			<user>user@example.com</user>
			<!-- SMTP password (blank for no authentication) -->
			<password>REDACTED</password>
			<!-- Application hostname -->
			<host>app.italiamultimedia.com</host>
		</smtp>
	</dev>
	<!-- Test Environment -->
	<test>
	</test>
	<!-- Production Environment -->
	<prod>
		<!-- SMTP Settings -->
		<smtp>
			<!-- Enable SSL? -->
			<ssl>0</ssl>
			<!-- SMTP Server hostname ( defaults to localhost ) -->
			<server>localhost</server>
			<!-- SMTP Server Port ( defaults to 25) -->
			<port>25</port>
			<!-- SMTP connection timeout (defaults to 45) -->
			<timeout>45</timeout>
			<!-- SMTP user name (blank for no authentication) -->
			<user></user>
			<!-- SMTP password (blank for no authentication) -->
			<password></password>
			<!-- Application hostname -->
			<host>italiamultimedia.com</host>
		</smtp>
	</prod>
</config>